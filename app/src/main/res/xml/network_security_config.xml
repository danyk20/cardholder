<?xml version="1.0" encoding="utf-8"?>
<!-- The only network access is downloading an official shop logo on request: HTTPS with system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
