<?xml version="1.0" encoding="utf-8"?>
<!-- Network access (official logos, update checks, OpenStreetMap map tiles) is HTTPS with system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
